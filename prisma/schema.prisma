generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Guest {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  attendance  String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Wish {
  id          String   @id @default(uuid())
  guestName   String
  message     String
  createdAt   DateTime @default(now())
}

model RSVP {
  id           String   @id @default(uuid())
  guestName    String
  attendance   String
  totalGuest   Int      @default(1)
  createdAt    DateTime @default(now())
}
